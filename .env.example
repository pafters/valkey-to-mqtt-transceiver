########### НАСТРОЙКИ СЕРВИСА 
# Порт на котором запускается сервис
BIND_PORT=5060


########### НАСТРОЙКИ VALKEY 
# Хост на котором развернут valkey
VALKEY_HOST=localhost
# Порт на котором доступен valkey
VALKEY_PORT=6379
# Обязательность авторизации по username и password при подключении к valkey. Значение true обязывает к авторизации
VALKEY_AUTH_REQUIRE=false
# Пользователь, с которого можно подключиться к valkey
VALKEY_USERNAME=user
# Пароль от аккаунта пользователя, с которого можно подключиться к valkey
VALKEY_PASSWORD=pswd
# Номер базы данных valkey, к которой подключается сервис
VALKEY_DB=1

########### НАСТРОЙКИ MQTT 
# Хост на котором развернут MQTT
MQTT_HOST=localhost
# Порт на котором доступен MQTT
MQTT_PORT=1883
# Пользователь, с которого можно подключиться к MQTT
MQTT_USERNAME=user
# Пароль от аккаунта пользователя, с которого можно подключиться к MQTT
MQTT_PASSWORD=pswd

# Уникальный идентификатор mqtt клиента
MQTT_CLIENT_ID=nestjs_client_01
# Префикс для добавления топиков в москит
MQTT_TOPIC_PREFIX=__TRANSMITTER

########### НАСТРОЙКИ БАЗЫ ДАННЫХ 
# субд, к которой подключается сервис
DB_TYPE=postgres
# хост, на котором расположена субд
DB_HOST=127.0.0.1
# Порт на котором доступна субд
DB_PORT=5432
# Название базы данных, используяемая в сервисе
DB_NAME=m500
# Пользователь, с которого можно подключиться к базе данных
DB_USER=user
# Пароль от аккаунта пользователя, с которого можно подключиться к базе данных
DB_PASSWORD=pswrd

## НАСТРОЙКИ ЯЗЫКА ПЕРЕВОДА
VOCABULARY_LANG=ru

########### НАСТРОЙКИ ОБНОВЛЕНИЯ КЭША УСТРОЙСТВ
## CRON-строка которая обозначает периодичность выполнения процедуры обновления кэша топиков для каждого устройства (updateDeviceLocationSiteMap)
CRON_UPDATE_CACHE=*/2 * * * *
## Максимальное время (в мс) ожидание обновления кэша до возвращения ошибки
MAX_LIMIT_IN_MS_AT_LAST_UPD_CACHE_BEFORE_ERROR=300000 # 5 минут
## Срок жизни (в мс) кэша качества связи
QUALITY_CACHE_LIFE_MS=5000 # 5 секунд
# CRON-строка которая обозначает периодичность выполнения отправки всех сообщений по MQTT из сервиса transmitter.service
CRON_SEND_ALL_TRANSMITTER_MESSAGES=*/10 * * * *
# CRON-строка которая обозначает периодичность выполнения отправки всех сообщений по MQTT из сервиса transcoder.service
CRON_SEND_ALL_TRANSCODER_MESSAGES=*/10 * * * *
